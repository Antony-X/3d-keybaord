// Preview renders only (not for printing): the cube with stand-in switches and keycaps.
//   view = "assembled" | "exploded" | "section" | "frame_assembled" | "frame_exploded"
//          | "printed_assembled" | "printed_module"
use <switch_cube.scad>
use <frame_cube.scad>
use <click_module.scad>

view = "assembled";
cube_size = 30;
A = cube_size / 2;
$fn = 48;

cap_colors = ["#2f7fc1", "#e8692c", "#7a4bb3", "#7cc85a", "#d63a4a", "#26335c"];
face_rotations = [[0, 0, 0], [180, 0, 0], [0, 90, 0], [0, -90, 0], [-90, 0, 0], [90, 0, 0]];

module mx_switch() {
    // top housing (clear)
    color([0.85, 0.92, 1.0, 0.55])
        hull() {
            translate([0, 0, 0.5]) cube([15.6, 15.6, 1], center = true);
            translate([0, 0, 6.3]) cube([11.5, 11.5, 0.6], center = true);
        }
    // stem
    color("#3aa0e8") translate([0, 0, 6.6]) {
        translate([0, 0, 1.8]) cube([4.1, 1.2, 3.6], center = true);
        translate([0, 0, 1.8]) cube([1.2, 4.1, 3.6], center = true);
    }
    // bottom housing
    color("#eeeeee") translate([0, 0, -2.5]) cube([14, 14, 5], center = true);
    // pins and centre post
    color("#c9a050") for (p = [[-3.81, 2.54], [2.54, 5.08]])
        translate([p[0], p[1], -8.3]) cylinder(d = 1.3, h = 3.3);
    color("#eeeeee") translate([0, 0, -8]) cylinder(d = 4, h = 3);
}

// The printable DSA keycap from stl/ (generated by cad/keycap.scad), at rest.
module keycap(lift = 5.5) {
    translate([0, 0, lift]) import("../stl/keycap_dsa_fit0.2.stl");
}

module stack(i, explode = 0, plate_explode = -1) {
    rotate(face_rotations[i]) {
        if (plate_explode >= 0)
            color("#f4f4f2") translate([0, 0, A + plate_explode]) mirror([0, 0, 1]) plate();
        translate([0, 0, A + explode]) mx_switch();
        color(cap_colors[i]) translate([0, 0, A + 1.8 * explode]) keycap();
    }
}

if (view == "assembled") {
    color("#f4f4f2") switch_cube();
    for (i = [0 : 5]) stack(i);
} else if (view == "exploded") {
    color("#f4f4f2") switch_cube();
    for (i = [0 : 5]) stack(i, 14);
} else if (view == "frame_assembled") {
    color("#f4f4f2") frame();
    for (i = [0 : 5]) stack(i, 0, 0);
} else if (view == "frame_exploded") {
    color("#f4f4f2") frame();
    for (i = [0 : 5]) stack(i, 30, 14);
} else if (view == "printed_assembled") {
    // Fully printed version: frame + six click modules + printed keycaps.
    color("#f4f4f2") frame();
    for (i = [0 : 5]) rotate(face_rotations[i]) translate([0, 0, A]) {
        module_assembly(0);
        color(cap_colors[i]) translate([0, 0, 2.6]) import("../stl/keycap_dsa_fit0.2.stl");
    }
} else if (view == "printed_module") {
    // The four printed parts of one face, as they sit on the print bed.
    color("#f4f4f2") import("../stl/click_plate.stl");
    color("#3aa0e8") translate([22, 0, 0]) import("../stl/click_plunger.stl");
    color("#f0b030") translate([0, 26, 0]) import("../stl/click_spring.stl");
    color(cap_colors[0]) translate([24, 24, 0]) import("../stl/keycap_dsa_fit0.2.stl");
} else if (view == "section") {
    difference() {
        union() {
            color("#f4f4f2") switch_cube();
            for (i = [0 : 5]) stack(i);
        }
        translate([-60, 0, -60]) cube(120);
    }
}
